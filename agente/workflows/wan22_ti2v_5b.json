{
  "1": {"class_type": "UnetLoaderGGUF", "_meta": {"title": "Modelo Wan 2.2 TI2V-5B (GGUF)"},
        "inputs": {"unet_name": "Wan2.2-TI2V-5B-Q5_K_M.gguf"}},
  "2": {"class_type": "CLIPLoaderGGUF", "_meta": {"title": "Codificador de texto UMT5 (GGUF)"},
        "inputs": {"clip_name": "umt5-xxl-encoder-Q5_K_M.gguf", "type": "wan"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "VAE Wan 2.2"},
        "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
  "4": {"class_type": "ModelSamplingSD3", "_meta": {"title": "Shift"},
        "inputs": {"model": ["1", 0], "shift": 8}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt"},
        "inputs": {"clip": ["2", 0], "text": "{{prompt}}"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt negativo"},
        "inputs": {"clip": ["2", 0], "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走, text, watermark, logo"}},
  "7": {"class_type": "LoadImage", "_meta": {"title": "Fotograma inicial (opcional)"},
        "inputs": {"image": "{{start_image}}"}},
  "8": {"class_type": "Wan22ImageToVideoLatent", "_meta": {"title": "Latente de video"},
        "inputs": {"vae": ["3", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{frames}}",
                   "batch_size": 1, "start_image": ["7", 0]}},
  "9": {"class_type": "KSampler", "_meta": {"title": "Muestreo"},
        "inputs": {"model": ["4", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": 5,
                   "sampler_name": "uni_pc", "scheduler": "simple", "positive": ["5", 0],
                   "negative": ["6", 0], "latent_image": ["8", 0], "denoise": 1}},
  "10": {"class_type": "VAEDecode", "_meta": {"title": "Decodificar"},
         "inputs": {"samples": ["9", 0], "vae": ["3", 0]}},
  "11": {"class_type": "CreateVideo", "_meta": {"title": "Crear video"},
         "inputs": {"images": ["10", 0], "fps": "{{fps}}"}},
  "12": {"class_type": "SaveVideo", "_meta": {"title": "Guardar video"},
         "inputs": {"video": ["11", 0], "filename_prefix": "agente_clips/toma", "format": "mp4", "format.codec": "h264"}}
}
