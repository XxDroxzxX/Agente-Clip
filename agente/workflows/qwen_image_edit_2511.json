{
  "1": {"class_type": "UnetLoaderGGUF", "_meta": {"title": "Modelo Qwen Image Edit"},
        "inputs": {"unet_name": "qwen-image-edit-2511-Q2_K.gguf"}},
  "2": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "Lightning 4 pasos"},
        "inputs": {"model": ["1", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
                   "strength_model": 1.0}},
  "3": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "Muestreo"},
        "inputs": {"model": ["2", 0], "shift": 3.1}},
  "4": {"class_type": "CLIPLoaderGGUF", "_meta": {"title": "Codificador de texto"},
        "inputs": {"clip_name": "Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf", "type": "qwen_image"}},
  "5": {"class_type": "VAELoader", "_meta": {"title": "VAE"},
        "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "6": {"class_type": "LoadImage", "_meta": {"title": "Referencia del personaje"},
        "inputs": {"image": "{{ref_image}}"}},
  "7": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "Prompt"},
        "inputs": {"clip": ["4", 0], "prompt": "{{prompt}}", "vae": ["5", 0], "image1": ["6", 0]}},
  "8": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "Prompt negativo"},
        "inputs": {"clip": ["4", 0], "prompt": "", "vae": ["5", 0], "image1": ["6", 0]}},
  "9": {"class_type": "EmptySD3LatentImage", "_meta": {"title": "Lienzo"},
        "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "10": {"class_type": "KSampler", "_meta": {"title": "Muestreador"},
         "inputs": {"model": ["3", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": 1.0, "sampler_name": "euler",
                    "scheduler": "simple", "positive": ["7", 0], "negative": ["8", 0], "latent_image": ["9", 0],
                    "denoise": 1.0}},
  "11": {"class_type": "VAEDecode", "_meta": {"title": "Decodificar"},
         "inputs": {"samples": ["10", 0], "vae": ["5", 0]}},
  "12": {"class_type": "SaveImage", "_meta": {"title": "Guardar"},
         "inputs": {"images": ["11", 0], "filename_prefix": "agente_clips/qie"}}
}
